      <outline description="" text="Podcasts - History, Philosophy, etc.">
        <outline description="Scott and William put aside their continental differences to teach a history lesson to you (and hopefully a guest) each week in their attempt to come to a greater understanding about history, ideology and current affairs while having lots of laughs along the way." encoding="UTF-8" text="History Homos" title="History Homos" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/2431f8ac/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="The Martyr Made Podcast" encoding="UTF-8" text="The Martyr Made Podcast" title="The Martyr Made Podcast" type="rss" version="RSS" xmlUrl="https://feeds.blubrry.com/feeds/martyrmade_podcast.xml" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Where history and epic collide--&quot;History on Fire&quot; is a podcast by author and university professor Daniele Bolelli." encoding="UTF-8" text="History on Fire" title="History on Fire" type="rss" version="RSS" xmlUrl="https://rss.introcast.io/1038514498/feeds.megaphone.fm/TPG8904827717" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="With millions of downloads, hundreds of hours of soundtracked content, and an overall emphasis on the cultural history behind famous works of literature, Literature and History is one of the most popular independent podcasts on its subject. Starting with Sumerian cuneiform in 3,100 BCE, Literature and History moves forward in chronological order through Assyriology, Egyptology, the Old Testament, Ancient Greece and Rome, the birth of Christianity, and the early Middle Ages. The show's current season is on early Islamic history.&#xa;&#xa;A typical episode (they average about two hours) features a general introduction to a work of literature, then a full summary of that work that expects no prior knowledge, and finally, an analysis of the cultural, biographical, and historical forces that gave rise to the work in question. Original symphonic and ambient background music is woven throughout each show, and all episodes offer free full, illustrated, footnoted transcriptions as well as quizzes for purposes of review. The show has no advertisements, and its host takes pride in a professional approach that avoids chitchat and ephemera and gets straight to the educational content. You can listen to the episodes in any order, although most listeners begin at the beginning and proceed from there, as the podcast itself is chronologically organized.&#xa;&#xa;Doug Metzger finished his Ph.D. in literature in 2011. His chief scholarly interest, following his dissertation work, continues to be 19th-century realism and postbellum American philosophy." encoding="UTF-8" text="Literature and History" title="Literature and History" type="rss" version="RSS" xmlUrl="https://rss.libsyn.com/shows/77861/destinations/351744.xml" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Interviews, musings and extra material from the makers of Dan Carlin's Hardcore History.  If it did not fit in the HH feed it's probably here" encoding="UTF-8" text="Dan Carlin's Hardcore History: Addendum" title="Dan Carlin's Hardcore History: Addendum" type="rss" version="RSS" xmlUrl="https://rss.libsyn.com/shows/109255/destinations/596146.xml" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="In &quot;Hardcore History&quot; journalist and broadcaster Dan Carlin takes his &quot;Martian&quot;, unorthodox way of thinking and applies it to the past. Was Alexander the Great as bad a person as Adolf Hitler? What would Apaches with modern weapons be like? Will our modern civilization ever fall like civilizations from past eras? This isn't academic history (and Carlin isn't a historian) but the podcast's unique blend of high drama, masterful narration and Twilight Zone-style twists has entertained millions of listeners." encoding="UTF-8" text="Dan Carlin's Hardcore History" title="Dan Carlin's Hardcore History" type="rss" version="RSS" xmlUrl="http://feeds.feedburner.com/dancarlin/history?format=xml" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Big braned content on all topics." encoding="UTF-8" text="Not Related! A Big-Braned Podcast" title="Not Related! A Big-Braned Podcast" type="rss" version="RSS" xmlUrl="https://notrelated.xyz/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
      </outline>
      <outline description="" text="Podcasts - Comedy">
        <outline description="onde a importância é não ser importante." encoding="UTF-8" text="PavanCast" title="PavanCast" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/2213b13c/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="União dos casas." encoding="UTF-8" text="Parabellum" title="Parabellum" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/6d5d0134/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Toda semana no seu ouvidinho" encoding="UTF-8" text="Plantão Inútil" title="Plantão Inútil" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/700a82a8/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="O herói do ocidente entrevista" encoding="UTF-8" text="Loen Talks" title="Loen Talks" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/13a4f930/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Cum Town Premium Episodes&#xa;&#xa;★★★・・・・・・・・・・・・・・・・・・・・・・・★★★&#xa;&#xa;Cum Town is a comedy podcast that was hosted by New York City-based comedians Nick Mullen, Stavros Halkias, and Adam Friedland and produced between 2016 and 2022. During its run, it was consistently one of the most popular podcasts on Patreon and concluded as one of the top twenty-five comedy podcasts on Spotify and Apple Podcasts. In July 2022, it was succeeded by Mullen and Friedland&amp;#39;s spin-off podcast The Adam Friedland Show." encoding="UTF-8" text="Cum Town Premium" title="Cum Town Premium" type="rss" version="RSS" xmlUrl="http://rss.castbox.fm/everest/79b9b9699c674e0d974e74e2cbeeca19.xml" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
      </outline>
      <outline description="" text="Podcasts - Politics">
        <outline description="Podcast oficial da Nova Resistência " encoding="UTF-8" text="Pisando em Brasa" title="Pisando em Brasa" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/2847aab8/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="A weekly podcast by two Russians manoeuvring the hellscape of American cultural hegemony&#xa;&#xa;Patreon https://www.patreon.com/rwapodcast&#xa;Gumroad: https://gumroad.com/l/RWApodcast" encoding="UTF-8" text="Russians With Attitude" title="Russians With Attitude" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/440483e8/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Um podcast de um jovem nacionalista, cristão e que gosta de aproveitar assuntos polêmicos para uma boa conversa." encoding="UTF-8" text="Café Nacional" title="Café Nacional" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/3e36d3f8/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Weekly discussion on China and Silk Road, history, culture and current events" encoding="UTF-8" text="Silk And Steel Podcast" title="Silk And Steel Podcast" type="rss" version="RSS" xmlUrl="https://feed.podbean.com/silknsteel/feed.xml" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="" encoding="UTF-8" text="glycineputler's podcast" title="glycineputler's podcast" type="rss" version="RSS" xmlUrl="https://feeds.libsyn.com/217709/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="" encoding="UTF-8" text="Me Ne Frego Podcast" title="Me Ne Frego Podcast" type="rss" version="RSS" xmlUrl="https://feeds.feedburner.com/MeNeFregoPodcast" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Established in 2012, Radio 3Fourteen is a talk radio program hosted by Lana, heavily focusing on European identity and culture. Lana speaks with various bloggers, authors and social commentators for one hour every other week. The show is commercial free, supported by listeners and is available on demand as part of the Red Ice network on Redice.tv. Red Ice members also have access to a filmed version of selected interviews." encoding="UTF-8" text="Radio 3Fourteen" title="Radio 3Fourteen" type="rss" version="RSS" xmlUrl="https://redice.tv/rss/radio-3fourteen" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Loud, fast-talking and deceptively funny, this politically-independent &quot;forward-thinking pragmatist&quot; looks at the events shaping our world through a uniquely American lens. It's smarter than you think, and faster than you expect." encoding="UTF-8" text="Common Sense with Dan Carlin" title="Common Sense with Dan Carlin" type="rss" version="RSS" xmlUrl="http://feeds.feedburner.com/dancarlin/commonsense?format=xml" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
      </outline>
      <outline description="" text="Podcasts - News">
        <outline description="&lt;p>Welcome to S2 Underground, a freelance intelligence agency that brings real time intelligence reporting to the frontline fight against terrorism, fake news, and political tyranny around the world.&lt;/p>" encoding="UTF-8" text="S2 Underground" title="S2 Underground" type="rss" version="RSS" xmlUrl="https://rss.buzzsprout.com/868255.rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Headquartered in Sweden and North America, Red Ice Radio is a talk radio program hosted by Henrik Palmgren, predominately focusing on issues concerning European survival. Henrik interviews authors, researchers and commentators for two hours, three times a week. The second hour is available for members. The show is independent, commercial free and supported by members, available on demand directly from redice.tv." encoding="UTF-8" text="Red Ice Radio" title="Red Ice Radio" type="rss" version="RSS" xmlUrl="https://redice.tv/rss/red-ice-radio" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
      </outline>
      <outline description="" text="Podcasts - Conspiracy">
        <outline description="Mundo Freak Confidencial é o maior podcast de casos insólitos e paranormalidade da podosfera brasileira. Procuram balancear o papo leve e divertido entre céticos, crédulos (believers) e o meio termo." encoding="UTF-8" text="Mundo Freak Confidencial" title="Mundo Freak Confidencial" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/3a943b28/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Apresentado por Fernando Ribas e Leonardo Marques, o Paranormal FM é um podcast sobre assuntos Paranormais, Casos do Insólito, Ufologia, e tudo relacionado ao tema. Com uma temática de rádio, o podcast foi inspirado pela antiga Rádio Quitandinha, de Petrópolis, que hoje dizem ser assombrada." encoding="UTF-8" text="Paranormal FM" title="Paranormal FM" type="rss" version="RSS" xmlUrl="https://www.omnycontent.com/d/playlist/f7f86f6a-2fbd-4ac7-ab53-b01900e5d187/50a04b8b-4a61-489a-8fb6-b217011eebe0/dccb57e5-3774-4557-8519-b217011eec71/podcast.rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Rony Vernet, Engenheiro Eletrônico e Físico, analisa as últimas notícias do Brasil e do mundo sobre OVNIs e outros fenômenos anômalos não identificados." encoding="UTF-8" text="Correio do Extraordinário" title="Correio do Extraordinário" type="rss" version="RSS" xmlUrl="https://www.spreaker.com/show/6027209/episodes/feed" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Always interesting and often hilarious, join hosts Joe Hodgdon and Brandon Thomas as they investigate the latest in reality, futurology, weird science, consciousness research, alternative history, cryptozoology, UFOs, and new-age absurdity." encoding="UTF-8" text="Mysterious Universe" title="Mysterious Universe" type="rss" version="RSS" xmlUrl="https://feeds.megaphone.fm/mupod" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="A Frequência X se tornou o Bunker X!&#xa;OVNIs, aparições ectoplásmicas, criaturas sobrenaturais... vista seu capacete de alumínio e venha desvendar com os agentes do paranormal Affonso Solano e Afonso3D as investigações do BUNKER X, a sua dose semanal de Verdade aqui no Spotify e também no Youtube." encoding="UTF-8" text="Bunker X" title="Bunker X" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/d02d9508/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="&lt;p>Your favorite show! Spoop, conspiracy, esoterica, the occult, and more!&lt;/p>" encoding="UTF-8" text="The Paranormies " title="The Paranormies " type="rss" version="RSS" xmlUrl="https://media.rss.com/the-paranormies/feed.xml" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="The best audio selections from Jay Dyer.&lt;br />&lt;br />Become a supporter of this podcast: &lt;a href=&quot;https://www.spreaker.com/podcast/jay-sanalysis--1423846/support?utm_source=rss&amp;utm_medium=rss&amp;utm_campaign=rss&quot;>https://www.spreaker.com/podcast/jay-sanalysis--1423846/support&lt;/a>." encoding="UTF-8" text="Jay'sAnalysis" title="Jay'sAnalysis" type="rss" version="RSS" xmlUrl="https://www.spreaker.com/show/1423846/episodes/feed" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
      </outline>
      <outline description="Cultura, entretenimento e, principalmente, diversão!" encoding="UTF-8" text="Papo Furado Podcast" title="Papo Furado Podcast" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/721f0168/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
