    <outline description="" text="Podcasts">
      <outline description="" text="Podcasts - Music">
        <outline description="A podcast about Brazilian music of all styles, decades, and genres hosted by Leandro Vignoli. Follow updates on Instagram: &lt;a href=&quot;https://www.instagram.com/brazucasounds&quot; target=&quot;_blank&quot;>@brazucasounds&lt;/a>. Access our playlist &lt;a href=&quot;https://open.spotify.com/playlist/3pg1IYn1jf10C1qzfURCv7?si=4d02996716bd4f8b&quot; target=&quot;_blank&quot;>Soundtrack Brazuca Sounds&lt;/a> with all songs ever played on the show: &lt;p>&lt;/p> &lt;a target=&quot;_blank&quot; href=&quot;https://open.acast.com/public/patreon/fanSubscribe/11429343&quot;>Get bonus content on Patreon&lt;/a>&lt;br />&lt;hr />&lt;p> &lt;/p>" encoding="UTF-8" text="Brazuca Sounds" title="Brazuca Sounds" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/fe68f480/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Programa mensal apresentado por Leo Lopes, apresentando a biografia e alguns dos maiores sucessos dos grandes nomes da música mundial!" encoding="UTF-8" text="Rádiofobia Classics" title="Rádiofobia Classics" type="rss" version="RSS" xmlUrl="https://www.omnycontent.com/d/playlist/f7f86f6a-2fbd-4ac7-ab53-b01900e5d187/d5d12a9c-c1d0-491e-a713-b05801509de0/12fb08d9-353f-4068-ab8b-b05801509df7/podcast.rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
