        <outline description="Feed Oficial da Nova Vertente Produções&#xa;Nvp Cultural / Nvp Entretenimento" encoding="UTF-8" text="NVP Nova Vertente" title="NVP Nova Vertente" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/30ee142c/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Affonso Solano, Beto Estrada e Didi Braguinha pilotam o podcast mais maluco da internet! Cinema, Games, HQ e cultura geek!" encoding="UTF-8" text="Matando Robos Gigantes" title="Matando Robos Gigantes" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/7f78c9c/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="Um podcast semanal sobre nostalgia e videogames que marcaram as nossas infâncias dos anos 80 e 90. " encoding="UTF-8" text="99Vidas - Nostalgia e Videogames" title="99Vidas - Nostalgia e Videogames" type="rss" version="RSS" xmlUrl="https://anchor.fm/s/f0480b34/podcast/rss" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="The official podcast of comedian Joe Rogan." encoding="UTF-8" text="The Joe Rogan Experience" title="The Joe Rogan Experience" type="rss" version="RSS" xmlUrl="https://feeds.megaphone.fm/GLT1412515089" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
        <outline description="A vida, o universo e tudo mais viram piada no Jovem Nerd! Há  20 anos, Alottoni e Azaghal comentam, com muito humor ácido e uma dose saudável de zoeira, os principais assuntos da cultura pop." encoding="UTF-8" text="NerdCast" title="NerdCast" type="rss" version="RSS" xmlUrl="https://feeds.megaphone.fm/JNPD6227286900" rssguard:postProcess="" rssguard:xmlUrlType="0" xmlns:rssguard="https://github.com/martinrotter/rssguard"/>
